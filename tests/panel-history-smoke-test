#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
panel="$repo_root/Panel.qml"

assert_panel_contains() {
  local pattern="$1"
  local behavior="$2"
  grep -Fq "$pattern" "$panel" || {
    printf 'FAIL: panel does not expose %s\n' "$behavior" >&2
    exit 1
  }
}

assert_panel_excludes() {
  local pattern="$1"
  local behavior="$2"
  if grep -Fq "$pattern" "$panel"; then
    printf 'FAIL: panel still exposes %s\n' "$behavior" >&2
    exit 1
  fi
}

assert_panel_contains 'text: "BATTERY ACTIVITY"' 'the compact battery activity section'
assert_panel_contains 'label: "Last time on battery"' 'the previous unplugged metric'
assert_panel_contains 'label: "Last charging time"' 'the completed charging metric'
assert_panel_contains 'return "Time on battery now"' 'the live unplugged metric'
assert_panel_contains 'BatteryHistory.continuousSampleSeconds(root.batteryActivityLoadedAt, root.nowEpoch)' 'sleep-safe live unplugged elapsed time'
assert_panel_contains 'battery-power-history") + " --activity 7"' 'the activity summary feed'
assert_panel_contains 'BatteryHistory.batteryActivityPresentation' 'the activity presentation boundary'
assert_panel_contains 'ratio: root.activityPresentation.lastTimeOnBattery.ratio' 'the normalized comparison bars'
assert_panel_contains 'color: root.chargeGraphColor' 'the charging activity accent'
assert_panel_contains 'border.width: modelData.active ? 1 : 0' 'the understated active treatment'
assert_panel_contains 'readonly property bool activelyCharging:' 'the connected-and-charging state gate'
assert_panel_contains 'BatteryHistory.activelyCharging(String(root.batteryInfo.state || ""), UPower.onBattery)' 'charging-state normalization over stale UPower state'
assert_panel_contains 'currentChargingStartedAt' 'the explicit persisted charging start'
assert_panel_contains 'currentChargingDuration' 'the continuously updated charging duration'
assert_panel_contains 'root.liveChargingStartedAt > 0 ? Math.max(0, root.nowEpoch - root.liveChargingStartedAt) : 0' 'an immediate live charging-duration fallback'
assert_panel_contains 'BatteryHistory.chargingStatusMessages' 'the centralized charging phrase pool'
assert_panel_contains 'BatteryHistory.nextChargingStatusMessage' 'non-repeating randomized phrase selection'
assert_panel_contains 'BatteryHistory.chargingStatusRotationInterval' 'the randomized four-to-eight-second interval'
assert_panel_contains 'running: root.opened && root.activelyCharging && !root.reducedMotion' 'rotation only while visible and actively charging'
assert_panel_contains 'id: chargingPhraseSwap' 'the restrained phrase transition'
assert_panel_contains 'duration: 120' 'the 240ms total charging phrase animation'
assert_panel_contains 'readonly property bool reducedMotion:' 'the reduced-motion setting'
assert_panel_contains 'root.reducedMotion ? "Charging" : root.currentChargingMessage' 'the static reduced-motion copy'
assert_panel_contains 'return "Fully charged"' 'the fully charged static state'
assert_panel_contains 'return "Plugged in"' 'the connected non-charging static state'
assert_panel_contains 'Loading battery history…' 'the loading state'
assert_panel_contains 'Battery history is temporarily unavailable.' 'the degraded state'
assert_panel_contains 'text: "LAST CHARGE"' 'the latest completed charge detail'
assert_panel_contains 'root.sessionDateTime(root.activityPresentation.lastChargeAt)' 'the last charge completion date and time'
assert_panel_excludes 'text: "BATTERY HISTORY"' 'the old battery history heading'
assert_panel_excludes 'text: "LAST 7 DAYS"' 'the old seven-day range'
assert_panel_excludes 'text: "DISCHARGE"' 'the separate discharge group'
assert_panel_excludes 'text: "CHARGING"' 'the separate charging group'
assert_panel_excludes 'root.recentDischargeSessions()' 'the per-session discharge rows'
assert_panel_excludes 'root.dischargingSummaryText' 'the completed-session averages'
assert_panel_contains 'text: "CONSUMPTION"' 'the preserved live graph'
assert_panel_contains 'text: "STATS"' 'the preserved settings and statistics'

printf 'PASS: native panel history smoke check\n'
